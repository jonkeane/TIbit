bits()
Prgm
Local d,c,md,u,s,x,h,n,b,i,r,v,z,k,a,f,t,q,j,y,w,du,df,lo,hi,p,ht,sc,bc
getMode("ALL")→md
Try
setMode({"Base","DEC","Exact/Approx","AUTO","Split Screen","FULL"})
{68580,73660,79375,81280,91440,100000,101600,106680,114300,120000,121920,127000,132080,140000,142240,148336,157480,158750,160000,162560,167640,177800,180000,182880,187960,193040,198120,200000,203200,208280,213360,218440,220000,236220,238125,240000,260000,264160,279400,280000,300000,302260,317500,320000,322580,340000,340360,355600,360000,370840,380000,386080,396875,398780,400000,411480,416560,420000,436880,440000,452120,460000,474980,476250,480000,487680,497840,500000,505460,515620,520000,528320,540000,541020,555625,558800,560000,563880,574040,580000,589280,600000,609600,620000,635000,640000,652780,660000,680000,690880,700000,713740,714375,720000,731520,740000,746760,759460,760000,772160,780000,782320,793750,797560,800000,807720,817880,820000,840000,843280,860000,861060,873125,878840,880000,899160,900000,914400,920000,924560,939800,940000,952500,960000,960120,970280,980000,982980,995680,1000000,1010920,1020000,1021080,1031875,1036320,1040000,1043940,1060000,1061720,1080000,1082040,1100000,1111250,1120000,1122680,1140000,1158240,1160000,1180000,1188720,1190625,1200000,1209040,1220000,1229360,1240000,1249680,1260000,1270000,1270000,1280000,1300000,1305560,1320000,1325880,1340000,1349375,1351280,1360000,1380000,1381760,1400000,1407160,1420000,1427480,1428750,1440000,1460000,1473200,1480000,1498600,1500000,1508125,1520000,1534160,1540000,1560000,1580000,1587500,1600000,1605280,1620000,1640000,1640840,1660000,1666875,1680000,1686560,1700000,1720000,1722120,1740000,1746250,1760000,1767840,1780000,1800000,1818640,1820000,1825625,1840000,1860000,1869440,1880000,1900000,1905000,1915160,1920000,1940000,1960000,1960880,1980000,1984375,2000000,2016760,2020000,2040000,2052320,2060000,2063750,2080000,2098040,2100000,2120000,2140000,2143125,2160000,2180000,2200000,2222500,2300000,2301875,2381250,2400000,2460625,2500000,2540000,2600000,2619375,2698750,2700000,2778125,2800000,2857500,2900000,2936875,3000000,3016250,3095625,3100000,3175000,3200000,3254375,3300000,3333750,3400000,3413125,3492500,3500000,3571875,3600000,3651250,3700000,3730625,3800000,3810000,3889375,3900000,3968750,4000000,4048125,4100000,4127500,4200000,4206875,4286250,4300000,4365625,4400000,4445000,4500000,4524375,4600000,4603750,4683125,4700000,4762500,4800000,4841875,4900000,4921250,5000000,5000625,5080000}→d
{1,2,107,3,4,171,5,6,7,172,8,9,10,173,11,12,13,108,174,14,15,16,175,17,18,19,20,176,21,22,23,24,177,25,109,178,179,26,27,180,181,28,110,182,29,183,30,31,184,32,185,33,111,34,186,35,36,187,37,188,38,189,39,112,190,40,41,191,42,43,192,44,193,45,113,46,194,47,48,195,49,196,50,197,114,198,51,199,200,52,201,53,115,202,54,203,55,56,204,57,205,58,116,59,206,60,61,207,208,62,209,63,117,64,210,65,211,66,212,67,68,213,118,214,69,70,215,71,72,216,73,217,74,119,75,218,76,219,77,220,78,221,120,222,79,223,80,224,225,81,121,226,82,227,83,228,84,229,122,85,230,231,86,232,87,233,123,88,234,235,89,236,90,237,91,124,238,239,92,240,93,241,125,242,94,243,244,245,126,246,95,247,248,96,249,127,250,97,251,252,98,253,128,254,99,255,256,100,257,129,258,259,101,260,261,130,102,262,263,264,103,265,131,266,104,267,268,105,269,132,270,106,271,272,273,133,274,275,276,134,277,135,136,278,137,279,138,280,139,140,281,141,282,142,283,143,284,144,145,285,146,286,147,287,148,288,149,150,289,151,290,152,291,153,292,154,155,293,156,294,157,295,158,296,159,160,297,161,298,162,299,163,300,164,165,301,166,302,167,303,168,304,169,170}→c
dim(d)→n
2→u
""→s
0→z
Loop
 Dialog
  Title "Drill bit size"
  Request "Hole",s,0
  DropDown "Units",{"in","mm"},u
 EndDlog
 If ok=0
  Exit
 0→v
 Try
  approx(expr(s))→x
  If getType(x)="NUM" Then
   If u=1 Then
    If x≥0 and x≤1
     1→v
   Else
    If x≥0 and x≤25.4
     1→v
   EndIf
  EndIf
 Else
  ClrErr
 EndTry
 If v=0 Then
  Text "Use 0-1 in or 0-25.4 mm."
 Else
  If u=1 Then
   x*5080000→h
  Else
   x*200000→h
  EndIf
  1→lo
  n+1→hi
  h+1/1000000→q
  While lo<hi
   intDiv(lo+hi,2)→i
   If d[i]≤q Then
    i+1→lo
   Else
    i→hi
   EndIf
  EndWhile
  lo-1→p
  1→b
  If p>0 Then
   p→b
   If p<n Then
    If abs(d[p+1]-h)<abs(d[p]-h)-1/1000000
     p+1→b
   EndIf
  EndIf
  While b>1
   If d[b-1]≠d[b]
    Exit
   b-1→b
  EndWhile
  b→sc
  If p>b
   p→sc
  sc→bc
  u→du
  exact(floor(h/79375+1/2))→q
  format(x,"f3")→ht
  If mid(ht,1,1)="."
   "0"&ht→ht
  ht&mid("inmm",2*u-1,2)→ht
  If u=2 Then
   format(h/5080000,"f3")→w
   If mid(w,1,1)="."
    "0"&w→w
   ht&" "&w&"in"→ht
  EndIf
  ht&" ~"&string(q/64)&"in"→ht
  Loop
   {0,0,0,0,0,0}→r
   For j,1,6
    sc+j-3→i
    If i≥1 and i≤n Then
     If b≤p Then
      If i=p Then
       b→i
      ElseIf i≥b and i<p Then
       i+1→i
      EndIf
     EndIf
     i→r[j]
    EndIf
   EndFor
   If du=1 Then
    5080000→df
    "f4"→f
   Else
    200000→df
    "f3"→f
   EndIf
   ClrIO
   Output 0,0,ht
   Output 8,6,"Bit"
   Output 8,56,"D "&mid("inmm",2*du-1,2)
   Output 8,104,"d "&mid("inmm",2*du-1,2)
   For j,1,6
    8*(j+1)→y
    ""→t
    If r[j]=b Then
     "*"→t
    ElseIf j=1 and bc<sc-2 Then
     "↑"→t
    ElseIf j=6 and bc>sc+3 Then
     "↓"→t
    EndIf
    Output y,0,t
    If r[j]=0 Then
     Output y,6,"--"
    Else
     r[j]→i
     c[i]→a
     If a≤80 Then
      "#"&format(81-a,"f0")→t
     ElseIf a≤106 Then
      char(a-16)→t
     ElseIf a≤170 Then
      string((a-106)/64)&"in"→t
     Else
      If a≤276 Then
       (a-166)/10→q
      Else
       (a-254)/2→q
      EndIf
      format(q,"f1")&"mm"→t
     EndIf
     Output y,6,t
     format(d[i]/df,f)→w
     If mid(w,1,1)="."
      "0"&w→w
     Output y,56,w
     d[i]-h→q
     If abs(q)<1/1000000 Then
      "="&format(0,f)→t
     Else
      "+"→t
      If q<0
       "-"→t
      format(abs(q)/df,f)→w
      If mid(w,1,1)="."
       "0"&w→w
      If expr(w)=0 Then
       If du=1 Then
        t&"<.0001"→t
       Else
        t&"<.001"→t
       EndIf
      Else
       t&w→t
      EndIf
     EndIf
     Output y,104,t
    EndIf
   EndFor
   Output 64,0,"F1:new F2:center F3:"&mid("inmm",5-2*du,2)&" ESC"
   Loop
    getKey()→k
    If k=338 and sc>1
     sc-1→sc
    If k=344 and sc<n
     sc+1→sc
    If k=269
     bc→sc
    If k=268 or k=269 or k=270 or k=264 or k=338 or k=344
     Exit
   EndLoop
   If k=270
    3-du→du
   If k=268
    Exit
   If k=264 Then
    1→z
    Exit
   EndIf
  EndLoop
 EndIf
 If z=1
  Exit
EndLoop
Else
 setMode(md)
 PassErr
EndTry
setMode(md)
DispHome
EndPrgm
